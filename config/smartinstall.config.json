{
  "configVersion": "1.0",
  "installersDirectory": "installers",
  "reportsDirectory": "reports",
  "logsDirectory": "logs",
  "outputRoot": "sessions",
  "agentLogPath": "logs/application.log",
  "logLevel": "Info",
  "schemaVersion": "1.0",
  "agentVersion": "0.1.0",
  "minFreeDiskSpaceGb": 1,
  "defaultInstallerTimeoutSeconds": 1800,
  "collectorPreSnapshotTimeoutSeconds": 30,
  "collectorPostSnapshotTimeoutSeconds": 60,
  "maxFilesystemEvents": 10000,
  "maxEventLogEntries": 50000,
  "maxMsiLogSizeMb": 200,
  "maxStdoutStderrLines": 50000,
  "maxProcessTreeDepth": 10,
  "copyDumpsDefault": false,
  "elevateInstallers": true,
  "guiPostInstallGraceSeconds": 20,
  "maxInstallerLogFiles": 40,
  "installerLogSearchDepth": 6,
  "autoRunSlm": true,
  "autoMonitorEnabled": true,
  "backgroundPollIntervalSeconds": 3,
  "autoMonitorMaxProcessAgeSeconds": 120,
  "autoMonitorCooldownSeconds": 600,
  "autoMonitorMaxConcurrent": 1,
  "enableWindowsNotifications": true,
  "minimizeToTray": true,
  "startMinimizedToTray": false,
  "autoStartAtLogin": false,
  "slmModel": "phi3:mini",
  "slmEmbeddingModel": "nomic-embed-text",
  "slmTopK": 2,
  "slmTimeoutSeconds": 300,
  "ragDocsDirectory": "rag_docs",
  "monitoredFilesystemPaths": [
    "%ProgramFiles%",
    "%LOCALAPPDATA%"
  ],
  "registrySnapshotKeys": [
    "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall",
    "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall"
  ]
}
